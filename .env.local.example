# Optional: connect a real Leela Chess Zero (lc0) engine. Restart `npm run dev` after editing.
# Download lc0 and a network file from https://lczero.org
LC0_PATH=/full/path/to/lc0
LC0_WEIGHTS=/full/path/to/network.pb.gz
# Optional, for example: cuda, metal, onnx-dml, blas
# LC0_BACKEND=

# Speed: how many lc0 processes review games at the same time (default 2, max 4).
# More is faster if your computer can handle it. Each process loads its own copy of the network.
# LC0_PROCESSES=2
# Extra lc0 options, for example: --threads=2 --minibatch-size=16
# LC0_ARGS=
